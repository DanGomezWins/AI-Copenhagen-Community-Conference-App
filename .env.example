# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, bypasses RLS. Never commit, never import into a client component.
# Prefer a new-style secret key (sb_secret_...) over the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The public key again, for the browser to subscribe with.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# The app's public origin. Set this to the custom domain in production, or
# every redirect the app builds points at the Railway URL instead.
NEXT_PUBLIC_SITE_URL=

# Bearer token the Open Space platform uses to push the agenda to
# POST /api/open-sessions. Generate a long random string.
OPEN_SESSIONS_TOKEN=

# Test-mode sign-in: signs an address straight in with no email sent. Both must
# be false in production. The server-only one is the security gate and is read
# at runtime; the NEXT_PUBLIC_ one only reveals the button and is inlined at
# build time, so changing it needs a redeploy.
ENABLE_DEV_SIGNIN=false
NEXT_PUBLIC_ENABLE_DEV_SIGNIN=false

# --- PostHog (EU cloud) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
